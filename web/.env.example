# Copie para .env.local. Nunca commite a chave.

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Recomendado para roteamento multi-provedor. Quando preenchido, tem prioridade
# sobre OPENAI_API_KEY. Modelos são tentados da esquerda para a direita.
AI_GATEWAY_API_KEY=
AI_FAST_MODELS=openai/gpt-5.6-luna,google/gemini-3.5-flash-lite
AI_ASSISTANT_MODELS=openai/gpt-5.6-luna,google/gemini-3.8-flash
AI_STRATEGY_MODELS=openai/gpt-5.6-sol,anthropic/claude-sonnet-4.6
AI_EXTRACTION_MODELS=google/gemini-3.5-flash-lite,openai/gpt-5.6-luna
AI_EMBEDDING_MODEL=openai/text-embedding-3-small
AI_TRANSCRIPTION_MODEL=openai/gpt-4o-mini-transcribe
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
AI_MAX_INPUT_CHARS=160000
AI_MAX_OUTPUT_TOKENS=2400
AI_REQUEST_TIMEOUT_MS=90000

# A fundação pode ser instalada sem liberar ferramentas mutáveis.
TAWPER_MULTI_AGENT_ENABLED=false
TAWPER_AGENT_WRITES_ENABLED=false

# Agente Geral interno no WhatsApp (somente leitura).
# Use um número dedicado. A lista real deve ficar apenas no ambiente, nunca no Git.
TAWPER_WHATSAPP_AGENT_ENABLED=false
TAWPER_WHATSAPP_AGENT_BOT_NUMBER=5517999999999
TAWPER_WHATSAPP_AGENT_WEBHOOK_TOKEN=
TAWPER_AI_WORKER_TOKEN=
TAWPER_WHATSAPP_AGENT_USERS_JSON=[{"phone":"5517988888888","name":"Pessoa autorizada","role":"gestor"}]

# O piloto pode reutilizar STEVO_API_URL/STEVO_API_KEY. Preencha estes dois
# somente quando o número do agente estiver em outra instância/servidor.
STEVO_AGENT_API_URL=
STEVO_AGENT_API_KEY=
