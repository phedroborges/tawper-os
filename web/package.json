{
  "name": "tawper-os",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 -p 4100",
    "build": "next build",
    "start": "next start -p 4100",
    "demo": "next build && next start -p 4100",
    "lint": "eslint",
    "test:assistant": "node --conditions=react-server --import tsx --test tests/assistant.test.ts",
    "test:assistant:live": "node --conditions=react-server --import tsx scripts/evaluate-assistant.ts",
    "test:assistant:browser": "playwright test tests/assistant.browser.spec.ts --workers=1",
    "db:push": "node scripts/apply-migrations.mjs"
  },
  "dependencies": {
    "@fontsource/poppins": "^5.3.0",
    "@supabase/supabase-js": "^2.117.3",
    "lucide-react": "^1.44.0",
    "next": "16.3.4",
    "openai": "7.36.0",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "zod": "4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "tsx": "4.23.15",
    "typescript": "^5"
  }
}
